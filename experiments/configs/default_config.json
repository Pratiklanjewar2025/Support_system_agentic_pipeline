{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "experiment_id": "EXP_DEFAULT_ADARAG_OPS",
  "description": "Master reference experiment configuration schema for AdaRAG-Ops research reproducibility.",
  "metadata": {
    "project": "AdaRAG-Ops: Research-Grade Operational Incident Diagnosis",
    "version": "1.0.0",
    "author": "AdaRAG Research Pair",
    "created_at": "2026-10-23T17:45:00Z"
  },
  "dataset": {
    "dataset_name": "all",
    "split_strategy": "grouped",
    "split_parameters": {
      "train_ratio": 0.60,
      "val_ratio": 0.20,
      "test_ratio": 0.20,
      "unseen_system": "train-ticket",
      "unseen_fault_types": ["DELAY", "LOSS", "SOCKET", "F2", "F4"]
    },
    "subsample_max_cases": null,
    "random_seed": 42
  },
  "random_seeds": {
    "dataset_seed": 42,
    "model_router_seed": 42,
    "calibration_seed": 42,
    "evaluation_seed": 42
  },
  "models": {
    "tier1_fast": {
      "name": "Cohere Command-R (35B)",
      "version": "cohere/command-r-08-2024",
      "provider": "cohere",
      "input_price_per_1m_usd": 0.15,
      "output_price_per_1m_usd": 0.60,
      "assumptions": "Standard Cohere Developer Tier (August 2024 release)"
    },
    "tier2_high_reasoning": {
      "name": "Google Gemini 2.5 Flash",
      "version": "google/gemini-2.5-flash",
      "provider": "google",
      "input_price_per_1m_usd": 0.075,
      "output_price_per_1m_usd": 0.30,
      "assumptions": "Google AI Studio Developer Pay-as-you-go Tier"
    },
    "tier3_heavy": {
      "name": "Cohere Command-R+ (104B)",
      "version": "cohere/command-r-plus-08-2024",
      "provider": "cohere",
      "input_price_per_1m_usd": 2.50,
      "output_price_per_1m_usd": 10.00,
      "assumptions": "Cohere Enterprise 104B Tier (August 2024 release)"
    },
    "fallback_free": {
      "name": "NVIDIA Nemotron 3.5 Lightning",
      "version": "nvidia/nemotron-3.5-lightning",
      "provider": "openrouter",
      "input_price_per_1m_usd": 0.00,
      "output_price_per_1m_usd": 0.00,
      "assumptions": "OpenRouter Free Tier (rate-limited)"
    }
  },
  "router": {
    "router_type": "intervention_aware",
    "feature_schema_path": "artifacts/calibration/feature_schema.json",
    "feature_dim": 14,
    "strategy": "quality_first",
    "enable_retrieval_confidence_features": true
  },
  "calibration": {
    "calibrator_type": "isotonic",
    "calibrator_model_path": "artifacts/calibration/calibrated_estimator.joblib",
    "n_bins": 5,
    "bin_strategy": "uniform",
    "default_confidence_threshold": 0.50,
    "abstention_enabled": true
  },
  "constraints": {
    "target_quality": 0.70,
    "max_latency_budget_sec": 15.0,
    "max_cost_budget_usd": 0.005,
    "max_risk_threshold": 1.5,
    "max_retries": 2,
    "max_escalations": 1,
    "allow_escalation": true
  },
  "evaluation": {
    "metrics": [
      "root_cause_localization_hit1",
      "root_cause_localization_hit3",
      "root_cause_localization_hit5",
      "fault_classification_macro_f1",
      "structured_diagnosis_correctness",
      "evidence_grounding_precision",
      "evidence_grounding_recall",
      "unsupported_claim_rate",
      "supplementary_linguistic_bleu",
      "brier_score",
      "expected_calibration_error_ece",
      "maximum_calibration_error_mce",
      "selective_accuracy",
      "coverage",
      "abstention_rate",
      "actual_api_cost_usd",
      "estimated_cost_usd",
      "total_tokens",
      "median_latency_p50_sec",
      "p95_latency_sec",
      "quality_cost_efficiency_ratio"
    ],
    "confidence_level": 0.95,
    "paired_tests": [
      "paired_student_t_test",
      "wilcoxon_signed_rank_test"
    ],
    "effect_sizes": [
      "cohen_d",
      "cliff_delta"
    ],
    "output_dir": "experiments/runs"
  }
}
