  "configurations": {
    "CONFIG_A": {
      "config_id": "CONFIG_A",
      "config_name": "Configuration A: Fixed-Model RAG (No Cache, No Routing)",
      "cache_enabled": false,
      "semantic_cache_enabled": false,
      "router_type": "fixed",
      "fixed_tier": "tier1_fast",
      "fixed_model_id": "command-r-08-2024",
      "allow_escalation": false,
      "active_retrieval_enabled": false,
      "verification_enabled": false,
      "calibration_enabled": false,
      "description": "Fixed fast model without caching or adaptive routing. Baseline RAG."
    },
    "CONFIG_B": {
      "config_id": "CONFIG_B",
      "config_name": "Configuration B: Fixed-Model RAG + Cache",
      "cache_enabled": true,
      "semantic_cache_enabled": true,
