# Multi-Provider API Keys (Replace with your actual keys)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Technical-Agent-Support

# Default Provider & Model
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash

# Adaptive Cost-Priority Routing Mode
# Set to 'true' to favor free/cheap models and minimize AI billing
COST_PRIORITY_MODE=true

# Incident Cache Semantic Similarity Threshold (0.80 recommended for natural human queries)
INCIDENT_CACHE_SIMILARITY_THRESHOLD=0.80

